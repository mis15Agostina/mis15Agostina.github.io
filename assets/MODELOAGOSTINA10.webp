 --muted:#6b7280;
 --accent:#c2a990;
 --accent-2:#a38e73;
 }
 .inv-archived{
 display:grid;
 place-items:center;
 min-height:60vh;
 background:var(--bg);
 padding:32px;
 }
 .inv-archived .card{
 max-width:720px;
 width:100%;
 background:var(--card);
 border:1px solid #e5e7eb;
 border-radius:16px;
 padding:28px;
 text-align:center;
 }
 .inv-archived .badge{
 display:inline-block;
 padding:6px 12px;
 border-radius:999px;
 background:rgba(194,169,144,.15);
 font:600 12px/1 system-ui, sans-serif;
 color:var(--accent);
 text-transform:uppercase;
 letter-spacing:.5px;
 }
 .inv-archived h1{
 margin:20px 0 10px;
 font:800 clamp(22px,3.5vw,30px)/1.2 system-ui, sans-serif;
 color:var(--text);
 }
 .inv-archived p{
 margin:0 0 14px;
 font:400 16px/1.6 system-ui, sans-serif;
 color:var(--muted);
 }
 .inv-archived .cta{
 display:flex;
 flex-direction:column;
 align-items:center;
 gap:14px;
 margin-top:20px;
 }
 .inv-archived .btn-row{
 display:flex;
 gap:12px;
 justify-content:center;
 flex-wrap:wrap;
 }
 .inv-archived .btn{
 border-radius:10px;
 padding:12px 18px;
 font:600 15px/1 system-ui, sans-serif;
 cursor:pointer;
 text-decoration:none;
 transition:all .2s ease;
 }
 .inv-archived .btn-primary{
 background:var(--accent);
 color:white;
 }
 .inv-archived .btn-primary:hover{
 background:var(--accent-2);
 }
 .inv-archived .btn-ghost{
 background:transparent;
 color:var(--text);
 border:1px solid #d1d5db;
 }
 .inv-archived .btn-ghost:hover{
 border-color:var(--accent);
 color:var(--accent);
 }
 .inv-archived .subtle{
 margin-top:16px;
 font-size:13px;
 color:var(--muted);
 } </style><div class="card"> <span class="badge">¡EL EVENTO YA PASÓ!</span><h1>Esta invitación ya cumplió su misión.</h1><p>Fue parte de un evento que, seguro, fue tan hermoso como su invitación.</p><p>Si estás por preparar tu propia celebración y querés sorprender a tus invitados, descubrí nuestros modelos de invitaciones digitales.</p><div class="cta"> <a class="btn btn-primary" href="https://latarjetadigital.com.ar/">Ver modelos de invitaciones</a><div class="btn-row"> <a class="btn btn-ghost" href="https://instagram.com/latarjetadigital_" target="_blank">Instagram</a> <a class="btn btn-ghost" href="https://wa.me/message/3JPD7Z523T4VF1">WhatsApp</a></div></div><p class="subtle">¿Necesitás contactar con nuestro equipo? Matias está para ayudarte a través de WhatsApp</p></div></div></div></div><div class="wp-block-uagb-container uagb-block-608477dc alignfull uagb-is-root-container"><div class="uagb-container-inner-blocks-wrap"><p class="has-text-align-center has-small-font-size wp-block-paragraph"><strong>La Tarjeta Digital®</strong><br><em>es una marca registrada.</em></p></div></div></div> <script type="speculationrules"> {"prefetch":[{"source":"document","where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":["/wp-*.php","/wp-admin/*","/wp-content/uploads/*","/wp-content/*","/wp-content/plugins/*","/wp-content/themes/twentytwentyfour/*","/*\\?(.+)"]}},{"not":{"selector_matches":"a[rel~=\"nofollow\"]"}},{"not":{"selector_matches":".no-prefetch, .no-prefetch a"}}]},"eagerness":"conservative"}]} </script> <script id="ltd-qr-local-js" src="https://latarjetadigital.com.ar/wp-content/uploads/siteground-optimizer-assets/ltd-qr-local.min.js"></script> <script id="uagb-block-positioning-js-js" src="https://latarjetadigital.com.ar/wp-content/plugins/ultimate-addons-for-gutenberg/assets/js/spectra-block-positioning.min.js"></script> <script id="wp-emoji-settings" type="application/json"> {"baseUrl":"https://s.w.org/images/core/emoji/17.0.2/72x72/","ext":".png","svgUr