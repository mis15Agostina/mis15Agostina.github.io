//# sourceURL=https://latarjetadigital.com.ar/wp-includes/js/wp-emoji-loader.min.js </script><div id="ltdqr-modal" aria-hidden="true"><div class="ltdqr-overlay"></div><div class="ltdqr-box" role="dialog" aria-modal="true" aria-labelledby="ltdqr-title"> <button class="ltdqr-close" type="button" aria-label="Cerrar">×</button><div class="ltdqr-brand">LA TARJETA DIGITAL</div><h2 id="ltdqr-title">Para una mejor experiencia</h2><p>Escaneá este código QR con tu celular</p><div class="ltdqr-code"><canvas id="ltdqr-canvas" width="220" height="220"></canvas></div> <small>Se abrirá esta invitación en tu teléfono</small> <button class="ltdqr-continue" type="button">Continuar desde esta computadora</button></div></div> <style> #ltdqr-modal,#ltdqr-modal *{box-sizing:border-box}#ltdqr-modal{position:fixed;inset:0;z-index:2147483647;display:none;align-items:center;justify-content:center;padding:24px;font-family:Montserrat,Arial,sans-serif}#ltdqr-modal.on{display:flex}.ltdqr-overlay{position:absolute;inset:0;background:rgba(36, 36, 36, 0.64);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}.ltdqr-box{position:relative;z-index:1;width:100%;max-width:420px;padding:38px 34px 32px;background:#fff;border:1px solid rgba(194,169,144,.5);border-radius:24px;text-align:center;box-shadow:0 24px 70px rgba(0,0,0,.25);animation:ltdqrIn .22s ease}.ltdqr-close{position:absolute;top:13px;right:14px;width:36px;height:36px;display:flex;align-items:center;justify-content:center;padding:0;border:0;border-radius:50%;background:#f4f0ec;color:#69594e;font-family:Arial,sans-serif;font-size:24px;font-weight:400;line-height:1;cursor:pointer}.ltdqr-brand{margin-bottom:12px;color:#c2a990;font-size:11px;font-weight:700;letter-spacing:2px}.ltdqr-box h2{margin:0 0 10px;color:#4a4a4a;font-size:27px;line-height:1.2}.ltdqr-box p{margin:0 0 20px;color:#555;font-size:15px}.ltdqr-code{display:flex;align-items:center;justify-content:center;width:244px;height:244px;margin:0 auto 16px;padding:12px;background:#fff;border:1px solid #eadfd6;border-radius:18px}.ltdqr-code canvas{display:block;width:220px;height:220px}.ltdqr-box small{display:block;margin-bottom:20px;color:#777}.ltdqr-continue{width:100%;min-height:50px;border:0;border-radius:13px;background:#c2a990;color:#fff;font:700 14px Montserrat,Arial,sans-serif;cursor:pointer}body.ltdqr-lock{overflow:hidden}@keyframes ltdqrIn{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:none}}@media(max-width:1023px),(pointer:coarse){#ltdqr-modal{display:none!important}} </style> <script> (function(){
 function drawQR(){
 if(!window.matchMedia('(min-width:1024px) and (pointer:fine)').matches)return;
 var modal=document.getElementById('ltdqr-modal'),canvas=document.getElementById('ltdqr-canvas');
 if(!modal||!canvas||typeof window.LTDQRCode!=='function')return;
 try{
 var qr=new window.LTDQRCode(-1,1),url=window.location.href;
 qr.addData(url);qr.make();
 var ctx=canvas.getContext('2d'),count=qr.getModuleCount(),quiet=4,total=count+quiet*2,size=canvas.width,cell=size/total;
 ctx.fillStyle='#fff';ctx.fillRect(0,0,size,size);ctx.fillStyle='#4a4a4a';
 for(var r=0;r<count;r++)for(var c=0;c<count;c++)if(qr.isDark(r,c)){
 var x=Math.round((c+quiet)*cell),y=Math.round((r+quiet)*cell),x2=Math.round((c+quiet+1)*cell),y2=Math.round((r+quiet+1)*cell);
 ctx.fillRect(x,y,x2-x,y2-y);
 }
 modal.classList.add('on');modal.setAttribute('aria-hidden','false');document.body.classList.add('ltdqr-lock');
 var close=function(){modal.classList.remove('on');modal.setAttribute('aria-hidden','true');document.body.classList.remove('ltdqr-lock')};
 modal.querySelector('.ltdqr-close').onclick=close;modal.querySelector('.ltdqr-continue').onclick=close;modal.querySelector('.ltdqr-overlay').onclick=close;
 document.addEventListener('keydown',function(e){if(e.key==='Escape')close()},{once:true});
 }catch(e){console.error('LTD QR:',e)}
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',drawQR);else drawQR();
 })();
 </script></body></html>